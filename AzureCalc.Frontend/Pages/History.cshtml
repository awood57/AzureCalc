@page

@{
    var apiUrl = Environment.GetEnvironmentVariable("API_URL");
}

<h2 class="text-primary">History</h2>

<div class="container mt-3">
    <div class="row">
        <div class="col-md-6">
            <h4 class="text-secondary">Calculations</h4>
            <div id="calcContainer">
                <p>Loading calculations...</p>
            </div>
        </div>

        <div class="col-md-6">
            <h4 class="text-secondary">Conversions</h4>
            <div id="convContainer">
                <p>Loading conversions...</p>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", async () => {
	const calcContainer = document.getElementById("calcContainer");
	const convContainer = document.getElementById("convContainer");

	try {
        	const response = await fetch("@apiUrl/api/history/all");
        	const data = await response.json();

		const renderList = (items, isCalculation) => {
			if (!items || items.length === 0) {
				return "<p class='text-muted'>No history found.</p>";
			}
			
			let html = "<ul class='list-group'>";

			items.forEach(item => {
				let content;
				let timestamp = new Date(item.timestamp).toLocaleString();

				if (isCalculation) {
    					content = `<strong>${item.A} ${item.Operation} ${item.B}</strong> = ${item.Result}`;
				} else {
					content = `<strong>${item.InputValue} ${item.FromUnit}</strong> to <strong>${item.OutputValue} ${item.ToUnit}</strong>`;
				}
	
	
				html += `
					<li class="list-group-item">
						${content}
						<div class="text-muted small">${timestamp}</div>
					</li>
				`;
			});

			return html + "</ul>";
		};

		// Rendering
		// Calculations
		calcContainer.innerHTML = renderList(data.calculations, true);
		// Conversions
		convContainer.innerHTML = renderList(data.conversions, false);

	} catch (err) {
		console.error(err);
        	const errorMsg = "<p class='text-danger'>Error loading history.</p>";
        	// Display error in both containers
        	calcContainer.innerHTML = errorMsg;
        	convContainer.innerHTML = errorMsg;	
	}
});
</script>

